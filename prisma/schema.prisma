generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id         Int      @id @default(autoincrement())
  nombre     String
  precio     Float
  disponible Boolean  @default(true)
  creadoEn   DateTime @default(now())
}